# Neon (or any Postgres) connection string. Use the *direct* (non-pooled) URL
# for workers that rely on LISTEN/NOTIFY.
DATABASE_URL=postgres://user:password@host/relay?sslmode=verify-full

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public URL of the API (used for OAuth callback URLs).
BETTER_AUTH_URL=http://localhost:3000
# Dashboard origin, trusted for cookie-authenticated requests (CSRF).
DASHBOARD_URL=http://localhost:3001

# Optional: GitHub OAuth app (https://github.com/settings/developers).
# Callback URL: http://localhost:3000/auth/callback/github
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Endpoint address policy for the API (registration) and the worker (connect time):
# strict = https + public addresses only (default when NODE_ENV=production),
# permissive = also http/localhost/private receivers (default otherwise).
# ENDPOINT_URL_POLICY=permissive

# Delivery worker (apps/worker). Optional; defaults shown.
# WORKER_CONCURRENCY=10
# DELIVERY_TIMEOUT_MS=15000
# Circuit breaker opens after this many failures in a row (deliveries wait instead of sending).
# CIRCUIT_FAILURE_THRESHOLD=5
# Endpoints failing continuously for this long are disabled automatically.
# AUTO_DISABLE_AFTER_HOURS=120
# Delete event history (events, deliveries, attempts) older than this many days.
# RETENTION_DAYS=30
