{
  "name": "@relay/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json && concurrently -k -n tsc,api -c blue,green \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/platform-fastify": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@relay/db": "workspace:*",
    "@relay/shared": "workspace:*",
    "@scalar/nestjs-api-reference": "^1.2.36",
    "better-auth": "1.7.20",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "pino-pretty": "^13.2.0"
  }
}
