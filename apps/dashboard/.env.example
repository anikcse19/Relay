# Copy to apps/dashboard/.env.local (gitignored).
# Where the Relay API listens. Read at runtime by src/proxy.ts and server components.
API_URL=http://localhost:3000
# The API's public URL as producers call it: used in curl snippets and the docs link.
# NEXT_PUBLIC_* values are inlined into the client bundle at BUILD time.
NEXT_PUBLIC_API_PUBLIC_URL=http://localhost:3000
